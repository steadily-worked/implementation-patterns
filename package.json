{
  "name": "implementation-patterns",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check-types": "turbo run check-types",
    "lint:fix": "turbo run lint -- --fix",
    "format-and-lint:fix": "pnpm format && pnpm lint:fix",
    "ci:check": "pnpm format && pnpm lint && pnpm check-types && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.6.1",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
